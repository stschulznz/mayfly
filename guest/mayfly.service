[Unit]
Description=Mayfly fail-closed guest network
Requires=cloud-config.service
After=cloud-config.service
Before=display-manager.service
OnFailure=poweroff.target

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/lib/mayfly/network.sh
RemainAfterExit=yes
LimitCORE=0
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
